# Copiá este archivo a ".env" (sin ".example") y completá los valores
# reales. ".env" está en .gitignore: nunca se sube al repo.
#
# Ver FASE3.md para instrucciones paso a paso de cómo conseguir el token
# de Telegram y tu chat_id.

# --- Telegram ---
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- API interna (solo para el healthcheck de Docker y FreqUI local) ---
# Usuario y contraseña: elegí los que quieras, no tienen que ser
# complejos porque el puerto solo es accesible desde tu propia máquina
# (127.0.0.1). jwt_secret_key sí debe tener 32+ caracteres al azar
# (podés generarlo con: openssl rand -hex 32 — o cualquier generador de
# contraseñas largas).
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
